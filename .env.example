# Copy to .env and fill in. Nothing here is required to run in mock mode.
#
# Never commit the filled-in .env -- it is in .gitignore for a reason.

# --- The LLM behind the agent ---------------------------------------------
# Vision scoring, trust checks, report classification. Without a key the agent
# serves stub data and the app shows a "demo scoring" banner.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.
# A claude-* name is ignored with a warning -- it would 404 on OpenAI.
GOODDEED_MODEL=

# --- Places ----------------------------------------------------------------
# Google Maps Platform key with the "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=

# --- Place lookup ----------------------------------------------------------
# Typing "where I am" by hand is resolved through Nominatim (OpenStreetMap),
# which needs no key but does ask that requests identify the application and a
# way to reach whoever runs it. Set this before any real traffic, or the
# project's IP can be blocked.
GEOCODE_USER_AGENT=GoodDeedGo/0.1 (you@example.com)

# --- Behaviour -------------------------------------------------------------
# Force stub data even when the keys above are set: 1/true/yes
GOODDEED_USE_MOCKS=0

# Postgres connection string. Left empty, the backend uses local SQLite.
DATABASE_URL=

# Google Sign-In client id. Optional; email/password signup works without it.
GOOGLE_CLIENT_ID=
