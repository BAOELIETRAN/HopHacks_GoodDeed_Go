# Copy to .env and fill in. Nothing here is required to run in mock mode.

# Anthropic API key (vision scoring, trust checks, report classification)
ANTHROPIC_API_KEY=

# Google Maps Platform key with the "Places API (New)" enabled
GOOGLE_MAPS_API_KEY=

# Force stub data even when the keys above are set: 1/true/yes
GOODDEED_USE_MOCKS=0

# Model override (defaults to claude-opus-5)
GOODDEED_MODEL=claude-opus-5

# --- Deployment (set these in the Render dashboard, not here) -------------
# Supabase Postgres. Use the SESSION POOLER URI (port 5432 on the pooler
# host) -- Render's free tier is IPv4-only and Supabase's direct host is
# IPv6-only. Unset locally = SQLite file.
DATABASE_URL=

# Google Sign-In client ID (public, not a secret). Unset = the Google button
# is hidden and email/password still works.
GOOGLE_CLIENT_ID=

# Comma-separated origins allowed to call the API. Unset = any origin.
# Not needed when one service serves both the app and the API.
ALLOWED_ORIGINS=

# Guards POST /admin/refresh-opportunities, which triggers the daily
# opportunity refresh. Any long random string. Unset = endpoint disabled (404).
REFRESH_TOKEN=
